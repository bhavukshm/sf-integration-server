PORT=3000

# ── Logging ────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
# Can also be changed at runtime without a restart: GET/POST /admin/log-level
LOG_LEVEL=info

# ── Site login (required to use the UI / Connected App practice flows) ───────
APP_USERNAME=admin
APP_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string
# Set to true when the app is served over HTTPS (e.g. behind nginx TLS)
COOKIE_SECURE=false

# ── Scenario 2: CORS Lab ─────────────────────────────────────────────────────
CORS_ENABLED=true
CORS_ORIGIN=*

# ── Scenario 5: Continuation lab ─────────────────────────────────────────────
CONTINUATION_DELAY_MS=3000
CONTINUATION_MAX_DELAY_MS=10000

# ── Scenario 6: Inbound webhooks (hooks) ─────────────────────────────────────
# Leave empty to accept unsigned POSTs during practice; set a value to require X-Webhook-Secret
WEBHOOK_SECRET=

# ── Named Credentials practice (inbound — SF callouts → this server) ─────────
# 1) Basic Authentication → GET /api/nc/basic/orders
NC_BASIC_USERNAME=nc-basic-user
NC_BASIC_PASSWORD=nc-basic-pass

# 2) Custom Authentication → GET /api/nc/custom/inventory
NC_CUSTOM_HEADER_NAME=X-API-KEY
NC_CUSTOM_HEADER_VALUE=sf-practice-key-12345
# Legacy alias still used by /api/v1/secure-data
API_KEY=sf-practice-key-12345

# 3) JWT → GET /api/nc/jwt/accounts
# Download SF signing cert public key into certs/sf-jwt-public.crt
NC_JWT_AUDIENCE=https://your-public-host.example.com
NC_JWT_ISSUER=
NC_JWT_PUBLIC_CERT=sf-jwt-public.crt
NC_JWT_CLOCK_SKEW_SEC=60

# 4) OAuth 2.0 Client Credentials → POST /oauth/token + GET /api/v2/products
OAUTH_CLIENT_ID=sf-practice-client
OAUTH_CLIENT_SECRET=sf-practice-secret-abc987
TOKEN_TTL_SEC=3600

# ── FAQ API (inbound — simple API-key auth) ──────────────────────────────────
# GET /api/faqs — send header X-API-KEY: <value>
FAQ_API_KEY=faq-practice-key-98765

# ── MCP Server: case-resolution knowledge base tool (inbound — AI agents → this server) ──
# Streamable HTTP transport at POST /api/mcp. initialize/tools/list are open;
# the search_case_resolutions tool itself checks header X-MCP-API-KEY: <value>.
MCP_API_KEY=mcp-practice-token-xyz789

# ── Connected App (outbound — this server → Salesforce) ──────────────────────
SF_LOGIN_URL=https://login.salesforce.com
SF_TOKEN_URL=https://your-domain.my.salesforce.com/services/oauth2/token
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:3000/redirect
SF_JWT_USERNAME=
SF_CERT_DIR=certs
